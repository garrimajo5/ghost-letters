# Скопируйте в .env и заполните.
DOMAIN=ghost.example.ru
POSTGRES_PASSWORD=придумайте-длинный-пароль
# Сгенерировать: openssl rand -base64 48
JWT_SIGNING_KEY=
# Необязательно:
# API_IMAGE=ghcr.io/garrimajo5/ghost-letters-api:latest
# AUTH_PER_MINUTE=30

# Ключ API Yandex SpeechKit (сервисный аккаунт с ролью ai.speechkit-tts.user) — озвучка ботов; пусто — без озвучки.
YANDEX_SPEECHKIT_API_KEY=
