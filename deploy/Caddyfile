# HTTPS-сертификат Caddy получает сам. SignalR (WebSocket) проксируется без доп. настроек.
#   /api, /hubs, /health  → сервер игры
#   /download/            → страница загрузки и APK для Android
#   всё остальное         → веб-версия (для iPhone и браузеров)
{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /hubs/* /health
	handle @api {
		reverse_proxy api:8080
	}

	handle /download* {
		root * /srv
		header Cache-Control "no-cache"
		header /download/ghost-letters.apk Content-Type "application/vnd.android.package-archive"
		file_server
	}

	handle {
		root * /srv/web
		# Картинки карт, шрифты, звуки и движок меняются редко: сутки без запросов к серверу,
		# неделя после — показываем из кэша и тихо сверяемся в фоне.
		# (Раньше общий «no-cache» без условия перекрывал это правило: Caddy применяет его последним.)
		@static path /assets/* /canvaskit/* /icons/*
		header @static Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		# Код и index.html — новая версия сразу: браузер каждый раз сверяется с сервером (304, если не менялось).
		@code not path /assets/* /canvaskit/* /icons/*
		header @code Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Голосовой чат: сигнализация LiveKit (WebSocket) на поддомене, сертификат Caddy получает сам.
livekit.{$DOMAIN} {
	reverse_proxy livekit:7880
}
